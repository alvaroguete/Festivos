<Window x:Class="Festivos.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Festivos de Colombia" Width="390" Height="690" MinWidth="320" MinHeight="380" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" FontFamily="Segoe UI" Foreground="#413C29" Icon="pack://application:,,,/FestivosColombia;component/colombia.ico">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<Border Margin="9" CornerRadius="16" Background="{Binding BackgroundBrush}"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity=".22"/></Border.Effect>
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="22" Height="15" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Background="#FCD116"/><Border Grid.Row="1" Background="#003893"/><Border Grid.Row="2" Background="#CE1126"/></Grid><TextBlock Text="Colombia" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PinButton" Content="⚑" Padding="6,5" ToolTip="Siempre encima" Click="Pin"/><Button Content="⚙" Padding="6,5" ToolTip="Configuración" Click="Settings"/><Button Content="−" Padding="6,5" ToolTip="Minimizar" Click="Minimize"/><Button Content="×" Padding="6,5" ToolTip="Cerrar" Click="CloseWindow"/></StackPanel></Grid>
<Grid Grid.Row="1" Margin="0,12,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PrevYear" Content="«" ToolTip="Año anterior" Click="PreviousYear"/><Button x:Name="PrevMonth" Grid.Column="1" Content="‹" ToolTip="Mes anterior" Click="PreviousMonth"/><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="{Binding MonthName}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><ComboBox x:Name="YearPicker" Width="86" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Selecciona o escribe un año y pulsa Entrar" KeyDown="YearKey" SelectionChanged="YearSelected"/></StackPanel><Button x:Name="NextMonthButton" Grid.Column="3" Content="›" ToolTip="Mes siguiente" Click="NextMonth"/><Button x:Name="NextYearButton" Grid.Column="4" Content="»" ToolTip="Año siguiente" Click="NextYear"/></Grid>
<UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,4"><TextBlock Text="Lu" HorizontalAlignment="Center"/><TextBlock Text="Ma" HorizontalAlignment="Center"/><TextBlock Text="Mi" HorizontalAlignment="Center"/><TextBlock Text="Ju" HorizontalAlignment="Center"/><TextBlock Text="Vi" HorizontalAlignment="Center"/><TextBlock Text="Sá" HorizontalAlignment="Center"/><TextBlock Text="Do" HorizontalAlignment="Center" Foreground="#B52E3B"/></UniformGrid>
<UniformGrid x:Name="Days" Grid.Row="3" Rows="6" Columns="7"/>
<StackPanel x:Name="MonthPanel" Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="FESTIVOS DEL MES" FontSize="11" FontWeight="Bold"/><ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MonthHolidays"/></ScrollViewer><TextBlock x:Name="Description" TextWrapping="Wrap" MaxHeight="48" FontSize="11" Margin="0,5,0,0"/></StackPanel>
<StackPanel x:Name="UpcomingPanel" Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="PRÓXIMOS FESTIVOS · DESDE HOY" FontSize="11" FontWeight="Bold"/><StackPanel x:Name="Upcoming"/><Button Content="Volver al mes actual" Click="Today" HorizontalAlignment="Left" Margin="0,7,0,0"/></StackPanel>
</Grid></Border></Window>
